# Copy to /etc/ivsurface.env on the VM (chmod 600). Never commit the real file.

# Massive API key
MASSIVE_API_KEY=

# Cloudflare Access (Zero Trust -> Access -> Applications -> your app -> Overview)
# Team domain, e.g. yourteam.cloudflareaccess.com (no https://)
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag"
CF_ACCESS_AUD=
