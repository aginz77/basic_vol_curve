[Unit]
Description=IV surface Flask app (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ivsurface
WorkingDirectory=/opt/ivsurface/data
EnvironmentFile=/etc/ivsurface.env
# Bound to localhost only: the sole way in is through Cloudflare Tunnel.
ExecStart=/opt/ivsurface/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --timeout 60 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
